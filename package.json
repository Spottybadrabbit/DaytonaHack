{
  "name": "agents-in-the-wild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prompt to public agent \u2014 Claude Code builds your app inside an isolated Daytona sandbox.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:api": "tsc -p api/tsconfig.json --noEmit",
    "check:builder": "node scripts/check-builder.mjs",
    "verify": "npm run check && npm run check:api && npm run check:builder && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.32.0",
    "@daytona/sdk": "^0.207.0",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
