# Copy to .env and fill in real values. Never commit .env.
# Production values live in the Vercel dashboard (Project → Settings → Environment Variables).

# --- Legacy Express server (server/, local dev only) ---
DATABASE_URL=postgresql://user@localhost:5432/agents_db
PORT=3000
SESSION_SECRET=

# --- Apify (live actor data; optional) ---
APIFY_API_KEY=

# --- Clerk.com authentication + billing ---
# Publishable key is safe for the client; VITE_ prefix exposes it to the SPA build.
VITE_CLERK_PUBLISHABLE_KEY=
# Secret key is SERVER-ONLY (api/ functions). Never expose with a VITE_ prefix.
CLERK_SECRET_KEY=

# --- Clerk Chat (SMS/messaging — separate product from Clerk.com) ---
CLERK_CHAT_API_KEY=
CLERK_CHAT_WEBHOOK_SECRET=

# --- Builder Bros / Supabase backend (SERVER-ONLY) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Prompt-to-app builder (SERVER-ONLY) ---
DAYTONA_API_KEY=
ANTHROPIC_API_KEY=

# --- Legacy Convex rollback only ---
# VITE_CONVEX_URL=
